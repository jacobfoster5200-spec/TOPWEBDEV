{
  "name": "map-ventures-website",
  "version": "1.0.0",
  "private": true,
  "description": "MAP Ventures static website build tooling (Tailwind CSS production build).",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.min.css --watch",
    "optimize:images": "node ./Scripts/optimize-images.js"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.13"
  }
}
